<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="WebDriver Suite" parallel="classes" thread-count="2">
    <test name="Chrome Test">
    <parameter name="browserName" value="CHROME"/>
    <classes>
        <class name="automationExerciseTests.Products"/>
        <class name="automationExerciseTests.UserRegistration"/>
    </classes>
    </test>
    <test name="Firefox Test">
        <parameter name="browserName" value="FIREFOX"/>
        <classes>
            <class name="automationExerciseTests.Products"/>
            <class name="automationExerciseTests.UserRegistration"/>
        </classes>
    </test>
</suite>
